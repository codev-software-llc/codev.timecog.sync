<?xml version="1.0"?>
<package >
  <metadata>
    <id>Codev.TimeCog.Sync</id>
    <version>9.0.0</version>
    <authors>Codev Software, LLC</authors>
    <owners>Codev Software, LLC</owners>
    <language>en-US</language>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <title>TimeCog Sync Models</title>
    <description>This contains the common TimeCog models for client server communications (Net 9.0)</description>
    <copyright>Copyright 2025</copyright>
    <icon>images\Codev_Logo.png</icon>
    <readme>docs\readme.md</readme>
    <dependencies>
      <group targetFramework="net9.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\docs\readme.md" target="docs\" />
    <file src="..\images\Codev_Logo.png" target="images\" />
    <file src="..\bin\sync\live\net9.0\*.dll" target="lib\net9.0" />
    <file src="..\bin\sync\live\net9.0\*.pdb" target="lib\net9.0\symbols" />
  </files>
</package>
